{
  "name": "reposys-print-agent",
  "version": "1.0.0",
  "description": "Reposys Print Agent for campus reprography",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:dir": "electron-builder --win --dir",
    "generate-test-pdf": "node scripts/generate-test-pdf.js",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "auto-launch": "^5.0.6",
    "axios": "^1.6.0",
    "electron-store": "^8.1.0",
    "pdf-to-printer": "^5.2.1",
    "pdfkit": "^0.13.0",
    "png-to-ico": "^3.0.2",
    "socket.io-client": "^4.7.2"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.reposys.print-agent",
    "productName": "Reposys Print Agent",
    "copyright": "Saintgits College of Engineering",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "agent/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/pdf-to-printer/**"
    ],
    "extraResources": [
      {
        "from": "assets/test.pdf",
        "to": "assets/test.pdf"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Reposys Print Agent",
      "runAfterFinish": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "license": "assets/license.txt"
    }
  }
}
