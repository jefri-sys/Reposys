# ===========================
# Backend .gitignore
# ===========================

# Dependencies
node_modules/

# Environment variables
.env
.env.local
.env.*.local

# Logs
*.log
*.out.log
*.err.log
logs/

# Temp uploads / scratch
tmp/
uploads/

# OS files
.DS_Store
Thumbs.db

# Debug / test scripts (one-off)
*.mjs
debug_*.js

# Text output files
*.txt
out_cmd.txt
