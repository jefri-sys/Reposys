# ===========================
# Root .gitignore for SCRMS
# ===========================

# Dependencies
node_modules/

# Environment variables (NEVER commit secrets)
.env
.env.local
.env.*.local

# Logs
*.log
*.out.log
*.err.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output
dist/
build/

# OS files
.DS_Store
Thumbs.db

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

# Temp / scratch
tmp/
temp/
*.txt
out_cmd.txt

# Test / debug artifacts (do not commit)
*.mjs.bak
test_results.json
.vercel
